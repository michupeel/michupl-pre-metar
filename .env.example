# Optional adapters are disabled in Milestone 1. Never reuse a key in two sockets.
KNMI_API_KEY=
KNMI_NOTIFICATION_KEY=
METAR_WS_API_KEY=
# Optional local development worker (not loaded automatically; never used by collectors).
LOCAL_LLM_ENABLED=false
LOCAL_LLM_BASE_URL=http://127.0.0.1:8888/v1
LOCAL_LLM_MODEL=auto
LOCAL_LLM_TIMEOUT=120
LOCAL_LLM_MAX_CONCURRENCY=1
LOCAL_LLM_API_KEY=

# Optional Netatmo authentication helper; public-data runtime remains blocked.
NETATMO_ACCESS_TOKEN=
NETATMO_REFRESH_TOKEN=
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
